<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <!-- TS2026 Open API for this install is net48 x64 (Net48Runtime). x86/AnyCPU will not load. -->
    <LangVersion>latest</LangVersion>

    <!-- IMPORTANT for Tekla + dynamic support -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <!-- ========================= -->
  <!-- NUGET PACKAGES -->
  <!-- ========================= -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="PdfPig" Version="0.1.14" />
  </ItemGroup>

  <!-- ========================= -->
  <!-- SYSTEM REFERENCES -->
  <!-- ========================= -->
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Core" />
    <Reference Include="System" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Runtime.Serialization" />

    <!-- 🔥 FIX FOR CS0656 ERROR -->
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <!-- ========================= -->
  <!-- TEKLA REFERENCES -->
  <!-- ========================= -->
  <ItemGroup>

    <Reference Include="Tekla.Structures">
      <HintPath>C:\Program Files\Tekla Structures\2026.0\bin\Net48Runtime\Tekla.Structures.dll</HintPath>
      <Private>true</Private>
    </Reference>

    <Reference Include="Tekla.Structures.Model">
      <HintPath>C:\Program Files\Tekla Structures\2026.0\bin\Tekla.Structures.Model.dll</HintPath>
      <Private>true</Private>
    </Reference>

    <!-- Needed for DrawingGenerator.cs (DrawingHandler API) -->
    <Reference Include="Tekla.Structures.Drawing">
      <HintPath>C:\Program Files\Tekla Structures\2026.0\bin\Tekla.Structures.Drawing.dll</HintPath>
      <Private>true</Private>
    </Reference>

    <Reference Include="Tekla.Structures.Catalogs">
      <HintPath>C:\Program Files\Tekla Structures\2026.0\bin\Tekla.Structures.Catalogs.dll</HintPath>
      <Private>true</Private>
    </Reference>

    <Reference Include="Tekla.Structures.Plugins">
      <HintPath>C:\Program Files\Tekla Structures\2026.0\bin\Net48Runtime\Tekla.Structures.Plugins.dll</HintPath>
      <Private>true</Private>
    </Reference>

    <!-- Trimble.Remoting (pulled by Tekla.Structures) needs these beside the exe -->
    <Reference Include="System.Memory">
      <HintPath>C:\Program Files\Tekla Structures\2026.0\bin\System.Memory.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Buffers">
      <HintPath>C:\Program Files\Tekla Structures\2026.0\bin\System.Buffers.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Numerics.Vectors">
      <HintPath>C:\Program Files\Tekla Structures\2026.0\bin\System.Numerics.Vectors.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="System.Runtime.CompilerServices.Unsafe">
      <HintPath>C:\Program Files\Tekla Structures\2026.0\bin\System.Runtime.CompilerServices.Unsafe.dll</HintPath>
      <Private>true</Private>
    </Reference>

  </ItemGroup>

  <ItemGroup>
    <Compile Remove="LocalMacros\**\*.cs" />
    <Compile Remove="TeklaExtractor_Standalone_v2026\**\*.cs" />
    <Compile Remove="Final Check\**\*.cs" />
    <Compile Remove="Services_Backup\**\*.cs" />
    <Compile Remove="Tools\**\*.cs" />
    <Compile Remove="Scripts\**\*.cs" />
    <Compile Remove="_build_cast\**\*.cs" />
    <Compile Remove="temp.cs" />
    <Compile Remove="test.cs" />
    <Compile Remove="old.cs" />
    <Compile Remove="check_*.cs" />
    <Compile Remove="update_*.cs" />
    <Compile Remove="recover_*.cs" />
    <Content Include="LocalMacros\*.cs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\DrawingViewer\index.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- PdfPig nuget copies a different System.Memory; restore Tekla's after build -->
  <Target Name="CopyTeklaRuntimeDlls" AfterTargets="Build">
    <ItemGroup>
      <TeklaRuntimeDll Include="C:\Program Files\Tekla Structures\2026.0\bin\System.Memory.dll" />
      <TeklaRuntimeDll Include="C:\Program Files\Tekla Structures\2026.0\bin\System.Buffers.dll" />
      <TeklaRuntimeDll Include="C:\Program Files\Tekla Structures\2026.0\bin\System.Numerics.Vectors.dll" />
      <TeklaRuntimeDll Include="C:\Program Files\Tekla Structures\2026.0\bin\System.Runtime.CompilerServices.Unsafe.dll" />
      <TeklaRuntimeDll Include="C:\Program Files\Tekla Structures\2026.0\bin\System.Threading.Tasks.Extensions.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(TeklaRuntimeDll)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" />
  </Target>

</Project>
  <!-- prevent stray scratch files -->
